PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# CORS / Frontend URL
# Set to your Vercel production URL (https://triptastic.vercel.app)
# All *.vercel.app preview URLs are automatically allowed.
FRONTEND_URL=https://your-app.vercel.app
# Comma-separated list of any additional allowed origins (optional)
ADDITIONAL_ORIGINS=

# Google Gemini AI (Attraction Discovery & Itinerary Generation)
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

# OpenStreetMap / Nominatim (FREE, no key required)
# Used for real tourist place verification and coordinates geocoding.

# Geoapify Places API -- Real tourist attraction discovery
# Sign up free at https://www.geoapify.com/
GEOAPIFY_API_KEY=

# Open-Meteo -- Weather (FREE, no key required)
# https://open-meteo.com/ -- completely free, no sign-up, no key needed.

# ExchangeRate-API -- Currency Conversion
# Open-access endpoint (1500 req/day, no sign-up needed when key is blank):
#   https://open.er-api.com/v6/latest/INR
# Optional premium key: https://www.exchangerate-api.com/
CURRENCY_API_KEY=
CURRENCY_BASE=INR

# Destination Images
# Default (zero setup): Curated high-resolution fallback
# Optional upgrade: Pexels free developer API (better quality)
#   Sign up at https://www.pexels.com/api/
PEXELS_API_KEY=

# Location API (controls Nominatim external fallback for destination search)
LOCATION_API_ENABLED=true
LOCATION_API_THRESHOLD=3
LOCATION_API_KEY=

# Future Integrations (not yet active)
# Amadeus Flights: https://developers.amadeus.com/ (free test account)
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test
#
# RapidAPI Hotels: https://rapidapi.com/apidojo/api/booking (freemium)
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=booking-com.p.rapidapi.com
