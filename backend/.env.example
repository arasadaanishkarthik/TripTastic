PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=triptastic

CLIENT_URL=http://localhost:5173
FRONTEND_URL=

NODE_ENV=development

# -- External Location / Places API -------------------------------------------
# Default provider: OpenStreetMap Nominatim (free, no key required)
LOCATION_API_KEY=
LOCATION_API_ENABLED=true
LOCATION_API_THRESHOLD=3

# -- Groq AI -- Ultra-fast LLM Inference -------------------------------------
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=45000

# -- Geoapify Places API -- Real tourist attraction discovery -----------------
# Required for destination-aware attraction search before Gemini personalizes the itinerary.
GEOAPIFY_API_KEY=

# -- Open-Meteo -- Weather (FREE, no key required) ----------------------------
# https://open-meteo.com/ -- completely free, no sign-up, no key needed.

# -- ExchangeRate-API -- Currency Conversion -----------------------------------
# Open-access endpoint used when key is blank (1500 req/day, no sign-up):
#   https://open.er-api.com/v6/latest/INR
# Optional: set key for premium endpoint (higher limits)
#   https://www.exchangerate-api.com/ -- free tier: 1500 req/month
CURRENCY_API_KEY=
CURRENCY_BASE=INR

# -- Destination Images --------------------------------------------------------
# Default (zero setup): Unsplash Source CDN -- no key, no sign-up
# Optional upgrade: Pexels free developer API (better quality)
#   Sign up at https://www.pexels.com/api/ -- completely free
PEXELS_API_KEY=

# -- Future Integrations (not yet active) -------------------------------------
# Amadeus Flights: https://developers.amadeus.com/ (free test account)
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test
#
# RapidAPI Hotels: https://rapidapi.com/apidojo/api/booking (freemium)
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=booking-com.p.rapidapi.com
