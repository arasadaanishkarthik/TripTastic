# Frontend environment variables (Vite)
# Copy this file to .env and fill in your values.
# ⚠️  Do NOT put secrets or API keys here — this file is bundled into the client browser.

# Production: Set to your Render backend URL
# Works with or without trailing /api
# Example:
# VITE_API_URL=https://triptastic-e95w.onrender.com

# Local Development (defaults to http://localhost:5000/api if unset):
# VITE_API_URL=http://localhost:5000/api
